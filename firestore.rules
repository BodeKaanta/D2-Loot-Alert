rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
// (or paste into Firebase console > Firestore Database > Rules, then Publish).
//
// Only these collections are public: the game data the app shows (rotation,
// lootPools, catalog), and what's kept for checking the backend without logging
// in (history, meta). Anything else is private, so a collection added later only
// becomes public by being added to this list on purpose.
//
// All writes come from the backend through the Admin SDK, which ignores these
// rules, so no client is ever allowed to write.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{collection}/{document} {
      allow read: if collection in ['rotation', 'lootPools', 'catalog', 'history', 'meta'];
      allow write: if false;
    }
  }
}
