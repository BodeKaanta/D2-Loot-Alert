rules_version = '2';

// Paste into Firebase console > Firestore Database > Rules, then Publish.
//
// The app only ever reads (today's rotation, loot pools). All writes come from
// the backend through the Admin SDK, which ignores these rules, so no client
// is ever allowed to write.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
