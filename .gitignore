# Secrets: never commit these (the repo is public)
.env
# Firebase service-account keys (default download name: <project>-firebase-adminsdk-<id>.json)
*firebase-adminsdk*.json
service-account*.json

# Phase 0 output (raw API dumps)
phase0/output/

# Backend: local dry-run output and the virtualenv the Firebase CLI uses to deploy
backend/output/
backend/venv/

# Firebase CLI
.firebase/
firebase-debug.log

# Python
__pycache__/
.venv/

# Flutter app: Firebase client config, generated by `flutterfire configure` on each
# machine (see CLAUDE.md > App setup on a new machine). Not secret, but kept out of
# this public repo's history on purpose.
app/lib/firebase_options.dart
app/android/app/google-services.json
app/ios/Runner/GoogleService-Info.plist
